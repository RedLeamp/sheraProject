<Window x:Class="OfficeManagerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OfficeManagerWPF.ViewModels"
        Title="Office Manager - 공유오피스 관리 시스템" 
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Visual Studio Dark Theme 색상 -->
        <SolidColorBrush x:Key="VSDarkBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="VSLightBg" Color="#2D2D30"/>
        <SolidColorBrush x:Key="VSAccent" Color="#007ACC"/>
        <SolidColorBrush x:Key="VSTextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="VSTextSecondary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="VSBorder" Color="#3F3F46"/>
        <SolidColorBrush x:Key="VSHover" Color="#3E3E40"/>

        <!-- 버튼 스타일 -->
        <Style x:Key="VSButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource VSLightBg}"/>
            <Setter Property="Foreground" Value="{StaticResource VSTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VSBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource VSHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 액센트 버튼 -->
        <Style x:Key="VSAccentButton" TargetType="Button" BasedOn="{StaticResource VSButton}">
            <Setter Property="Background" Value="{StaticResource VSAccent}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽 사이드바 (VS 스타일) -->
        <Border Grid.Column="0" Background="{StaticResource VSLightBg}" BorderBrush="{StaticResource VSBorder}" BorderThickness="0,0,1,0">
            <StackPanel>
                <!-- 로고 및 타이틀 -->
                <Border Background="{StaticResource VSAccent}" Padding="20,15">
                    <StackPanel>
                        <TextBlock Text="OFFICE MANAGER" 
                                   Foreground="White" 
                                   FontSize="14" 
                                   FontWeight="Bold"/>
                        <TextBlock Text="공유오피스 관리" 
                                   Foreground="#E0E0E0" 
                                   FontSize="11"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 메뉴 항목 -->
                <StackPanel Margin="0,10,0,0">
                    <!-- 대시보드 -->
                    <TextBlock Text="📋 메인 메뉴" 
                               Foreground="{StaticResource VSTextSecondary}" 
                               FontSize="11" 
                               Margin="20,0,0,10"/>

                    <Separator Background="{StaticResource VSBorder}" Margin="15,5"/>

                    <!-- 업체 관리 -->
                    <Button Style="{StaticResource VSButton}" 
                            Command="{Binding OpenCompanyManagementCommand}"
                            Padding="20,12"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏢" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="업체 관리" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <!-- 입금/지출 -->
                    <Button Style="{StaticResource VSButton}" 
                            Command="{Binding OpenPaymentExpenseCommand}"
                            Padding="20,12"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="입금/지출 관리" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <!-- 미수금 -->
                    <Button Style="{StaticResource VSButton}" 
                            Command="{Binding OpenUnpaidManagementCommand}"
                            Padding="20,12"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="미수금 관리" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <Separator Background="{StaticResource VSBorder}" Margin="15,5"/>

                    <!-- 알림 설정 -->
                    <Button Style="{StaticResource VSButton}" 
                            Command="{Binding OpenNotificationSettingsCommand}"
                            Padding="20,12"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔔" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="알림 설정" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <!-- 알림 내역 -->
                    <Button Style="{StaticResource VSButton}" 
                            Command="{Binding OpenNotificationLogsCommand}"
                            Padding="20,12"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="알림 내역" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 메인 컨텐츠 영역 -->
        <Grid Grid.Column="1" Background="{StaticResource VSDarkBg}">
            <TabControl Background="{StaticResource VSDarkBg}" BorderThickness="0" Padding="10">
                <TabControl.Resources>
                    <!-- TabItem 스타일 -->
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="{StaticResource VSLightBg}"/>
                        <Setter Property="Foreground" Value="{StaticResource VSTextPrimary}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="20,10"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" Background="{TemplateBinding Background}" 
                                            BorderThickness="0" Margin="2,0" CornerRadius="3,3,0,0">
                                        <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" 
                                                        HorizontalAlignment="Center"
                                                        ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource VSAccent}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource VSHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- 대시보드 탭 -->
                <TabItem Header="📊 대시보드">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="30">
                            <!-- 헤더 -->
                            <Grid Margin="0,0,0,25">
                                <StackPanel>
                                    <TextBlock Text="DASHBOARD" 
                                               Foreground="{StaticResource VSTextPrimary}" 
                                               FontSize="24" 
                                               FontWeight="Light"/>
                                    <TextBlock Text="{Binding SelectedPeriod, StringFormat={}{0}}" 
                                               Foreground="{StaticResource VSTextSecondary}" 
                                               FontSize="13"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 지역별 필터 탭 (지역이 있을 때만 표시) -->
                            <Border Name="LocationFilterContainer" Visibility="Collapsed" Background="{StaticResource VSLightBg}" 
                                    BorderBrush="{StaticResource VSBorder}" BorderThickness="1" 
                                    Padding="15" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="🗺️ 지역별 보기" 
                                               Foreground="{StaticResource VSTextPrimary}" 
                                               FontSize="13" 
                                               FontWeight="SemiBold" 
                                               Margin="0,0,0,10"/>
                                    <TabControl Name="LocationFilterTabs" Background="Transparent" BorderThickness="0">
                                        <!-- 지역 탭들이 동적으로 추가됨 -->
                                    </TabControl>
                                </StackPanel>
                            </Border>

                            <!-- 통계 카드 그리드 -->
                            <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 총 입금액 -->
                        <Border Grid.Column="0" Background="{StaticResource VSLightBg}" 
                                BorderBrush="{StaticResource VSBorder}" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <TextBlock Text="총 입금액" 
                                           Foreground="{StaticResource VSTextSecondary}" 
                                           FontSize="12"/>
                                <TextBlock Text="{Binding TotalPayments, StringFormat={}{0:N0}원}" 
                                           Foreground="#4EC9B0" 
                                           FontSize="28" 
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="↑ Income" 
                                           Foreground="#4EC9B0" 
                                           FontSize="11"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 총 지출액 -->
                        <Border Grid.Column="2" Background="{StaticResource VSLightBg}" 
                                BorderBrush="{StaticResource VSBorder}" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <TextBlock Text="총 지출액" 
                                           Foreground="{StaticResource VSTextSecondary}" 
                                           FontSize="12"/>
                                <TextBlock Text="{Binding TotalExpenses, StringFormat={}{0:N0}원}" 
                                           Foreground="#F48771" 
                                           FontSize="28" 
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="↓ Expense" 
                                           Foreground="#F48771" 
                                           FontSize="11"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 순이익 -->
                        <Border Grid.Column="4" Background="{StaticResource VSLightBg}" 
                                BorderBrush="{StaticResource VSBorder}" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <TextBlock Text="순이익" 
                                           Foreground="{StaticResource VSTextSecondary}" 
                                           FontSize="12"/>
                                <TextBlock Text="{Binding NetProfit, StringFormat={}{0:N0}원}" 
                                           Foreground="#569CD6" 
                                           FontSize="28" 
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="= Net Profit" 
                                           Foreground="#569CD6" 
                                           FontSize="11"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 빠른 정보 -->
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource VSLightBg}" 
                                BorderBrush="{StaticResource VSBorder}" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <TextBlock Text="ACTIVE COMPANIES" 
                                           Foreground="{StaticResource VSTextSecondary}" 
                                           FontSize="11"/>
                                <TextBlock Text="{Binding ActiveCompanies, StringFormat={}{0}}" 
                                           Foreground="{StaticResource VSTextPrimary}" 
                                           FontSize="36" 
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="개 업체" 
                                           Foreground="{StaticResource VSTextSecondary}" 
                                           FontSize="12"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource VSLightBg}" 
                                BorderBrush="#DC3545" BorderThickness="2" Padding="20">
                            <StackPanel>
                                <TextBlock Text="UNPAID ACCOUNTS" 
                                           Foreground="{StaticResource VSTextSecondary}" 
                                           FontSize="11"/>
                                <TextBlock Text="{Binding UnpaidCount, StringFormat={}{0}}" 
                                           Foreground="#DC3545" 
                                           FontSize="36" 
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="건 미수금" 
                                           Foreground="#DC3545" 
                                           FontSize="12"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                            <!-- 안내 텍스트 -->
                            <Border Background="{StaticResource VSLightBg}" 
                                    BorderBrush="{StaticResource VSAccent}" 
                                    BorderThickness="2,0,0,0" 
                                    Padding="15"
                                    Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="💡 시스템 안내" 
                                               Foreground="{StaticResource VSTextPrimary}" 
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="• 미수금 알림: 월초(1-5일), 중순(13-17일), 월말(25-30일) 자동 발송" 
                                               Foreground="{StaticResource VSTextSecondary}" 
                                               FontSize="12"
                                               Margin="0,8,0,3"/>
                                    <TextBlock Text="• 월세 납부 알림: 7일 전, 3일 전, 당일 자동 발송 (SMS + 이메일)" 
                                               Foreground="{StaticResource VSTextSecondary}" 
                                               FontSize="12"
                                               Margin="0,0,0,3"/>
                                    <TextBlock Text="• 알림 설정 메뉴에서 SMS/이메일 설정을 완료해주세요" 
                                               Foreground="#DCDCAA" 
                                               FontSize="12"
                                               Margin="0,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 데이터 관리 탭 -->
                <TabItem Header="📋 데이터 관리">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <!-- 헤더 -->
                            <Grid Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="데이터 관리" 
                                               Foreground="{StaticResource VSTextPrimary}" 
                                               FontSize="20" 
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="업체, 입금, 지출 데이터를 관리합니다" 
                                               Foreground="{StaticResource VSTextSecondary}" 
                                               FontSize="12"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 서브 탭 -->
                            <TabControl Background="{StaticResource VSDarkBg}" BorderThickness="0">
                                <!-- 업체+입금 데이터 -->
                                <TabItem Header="업체 및 입금">
                                    <StackPanel Margin="15">
                                        <TextBlock Text="업체 데이터 (입금 내역 통합)" 
                                                   Foreground="{StaticResource VSTextPrimary}" 
                                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        
                                        <!-- 버튼 영역 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button Content="🔄 새로고침" Style="{StaticResource VSButton}" Margin="0,0,5,0" Padding="12,6"/>
                                            <Button Content="📥 임대내역 가져오기" Style="{StaticResource VSAccentButton}" Margin="0,0,5,0" Padding="12,6"/>
                                            <Button Content="📤 엑셀 내보내기" Style="{StaticResource VSButton}" Margin="0,0,5,0" Padding="12,6"/>
                                            <Button Content="🗑️ 데이터 초기화" Click="ClearCompanyData_Click" Background="#DC3545" Foreground="White" Padding="12,6" Margin="10,0,0,0"/>
                                        </StackPanel>

                                        <!-- 데이터그리드 플레이스홀더 -->
                                        <Border Background="{StaticResource VSLightBg}" BorderBrush="{StaticResource VSBorder}" BorderThickness="1" Padding="20" Height="400">
                                            <TextBlock Text="업체 및 입금 데이터가 여기에 표시됩니다" 
                                                       Foreground="{StaticResource VSTextSecondary}" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        
                                        <TextBlock Text="상태: 준비" Foreground="{StaticResource VSTextSecondary}" FontSize="11" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </TabItem>

                                <!-- 지출 데이터 -->
                                <TabItem Header="지출">
                                    <StackPanel Margin="15">
                                        <TextBlock Text="지출 데이터" 
                                                   Foreground="{StaticResource VSTextPrimary}" 
                                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        
                                        <!-- 버튼 영역 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button Content="🔄 새로고침" Style="{StaticResource VSButton}" Margin="0,0,5,0" Padding="12,6"/>
                                            <Button Content="📥 엑셀 가져오기" Style="{StaticResource VSButton}" Margin="0,0,5,0" Padding="12,6"/>
                                            <Button Content="📤 엑셀 내보내기" Style="{StaticResource VSButton}" Margin="0,0,5,0" Padding="12,6"/>
                                            <Button Content="🗑️ 데이터 초기화" Click="ClearExpenseData_Click" Background="#DC3545" Foreground="White" Padding="12,6" Margin="10,0,0,0"/>
                                        </StackPanel>

                                        <!-- 데이터그리드 플레이스홀더 -->
                                        <Border Background="{StaticResource VSLightBg}" BorderBrush="{StaticResource VSBorder}" BorderThickness="1" Padding="20" Height="400">
                                            <TextBlock Text="지출 데이터가 여기에 표시됩니다" 
                                                       Foreground="{StaticResource VSTextSecondary}" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        
                                        <TextBlock Text="상태: 준비" Foreground="{StaticResource VSTextSecondary}" FontSize="11" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 지역 관리 탭 -->
                <TabItem Header="🗺️ 지역 관리">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <!-- 헤더 -->
                            <Grid Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="지역 관리" 
                                               Foreground="{StaticResource VSTextPrimary}" 
                                               FontSize="20" 
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="지역을 추가하고 선택하여 관리합니다" 
                                               Foreground="{StaticResource VSTextSecondary}" 
                                               FontSize="12"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 지역 추가 영역 -->
                            <Border Background="{StaticResource VSLightBg}" BorderBrush="{StaticResource VSBorder}" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="✨ 새 지역 추가" Foreground="{StaticResource VSTextPrimary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 지역명 -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="지역명:" Foreground="{StaticResource VSTextSecondary}" VerticalAlignment="Center" Margin="0,0,15,0" Width="80"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Name="LocationNameInput" Background="{StaticResource VSDarkBg}" Foreground="{StaticResource VSTextPrimary}" BorderBrush="{StaticResource VSBorder}" Padding="8"/>

                                        <!-- 주소 -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="주소:" Foreground="{StaticResource VSTextSecondary}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Name="LocationAddressInput" Background="{StaticResource VSDarkBg}" Foreground="{StaticResource VSTextPrimary}" BorderBrush="{StaticResource VSBorder}" Padding="8"/>

                                        <!-- 담당자 -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="담당자:" Foreground="{StaticResource VSTextSecondary}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Name="LocationManagerInput" Background="{StaticResource VSDarkBg}" Foreground="{StaticResource VSTextPrimary}" BorderBrush="{StaticResource VSBorder}" Padding="8"/>

                                        <!-- 연락처 -->
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="연락처:" Foreground="{StaticResource VSTextSecondary}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                        <TextBox Grid.Row="6" Grid.Column="1" Name="LocationPhoneInput" Background="{StaticResource VSDarkBg}" Foreground="{StaticResource VSTextPrimary}" BorderBrush="{StaticResource VSBorder}" Padding="8"/>

                                        <!-- 비고 -->
                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="비고:" Foreground="{StaticResource VSTextSecondary}" VerticalAlignment="Top" Margin="0,8,15,0"/>
                                        <TextBox Grid.Row="8" Grid.Column="1" Name="LocationNotesInput" Background="{StaticResource VSDarkBg}" Foreground="{StaticResource VSTextPrimary}" BorderBrush="{StaticResource VSBorder}" Padding="8" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                                    </Grid>

                                    <Button Content="➕ 지역 추가" Click="AddLocation_Click" Style="{StaticResource VSAccentButton}" HorizontalAlignment="Right" Margin="0,15,0,0" Padding="15,8"/>
                                </StackPanel>
                            </Border>

                            <!-- 지역 목록 -->
                            <Border Background="{StaticResource VSLightBg}" BorderBrush="{StaticResource VSBorder}" BorderThickness="1" Padding="20">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15">
                                        <TextBlock Text="📍 등록된 지역 목록" Foreground="{StaticResource VSTextPrimary}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                        <Button Content="🔄 새로고침" Click="RefreshLocations_Click" Style="{StaticResource VSButton}" HorizontalAlignment="Right" Padding="10,5"/>
                                    </Grid>

                                    <!-- 지역 리스트 -->
                                    <Border Background="{StaticResource VSDarkBg}" BorderBrush="{StaticResource VSBorder}" BorderThickness="1" Padding="15" Height="300">
                                        <ListBox Name="LocationsListBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource VSTextPrimary}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource VSLightBg}" BorderBrush="{StaticResource VSBorder}" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="📍" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource VSTextPrimary}"/>
                                                                <TextBlock Text="{Binding Address}" FontSize="11" Foreground="{StaticResource VSTextSecondary}" Margin="0,3,0,0"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                    <TextBlock Text="담당자: " FontSize="10" Foreground="{StaticResource VSTextSecondary}"/>
                                                                    <TextBlock Text="{Binding Manager}" FontSize="10" Foreground="{StaticResource VSTextSecondary}"/>
                                                                    <TextBlock Text=" | 연락처: " FontSize="10" Foreground="{StaticResource VSTextSecondary}" Margin="10,0,0,0"/>
                                                                    <TextBlock Text="{Binding PhoneNumber}" FontSize="10" Foreground="{StaticResource VSTextSecondary}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                    
                                    <TextBlock Name="LocationStatusText" Text="상태: 준비" Foreground="{StaticResource VSTextSecondary}" FontSize="11" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
