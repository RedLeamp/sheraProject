                            </Grid>

                            <!-- 지역 추가 영역 -->
                            <Border Background="{StaticResource VSLightBg}" BorderBrush="{StaticResource VSBorder}" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="✨ 새 지역 추가" Foreground="{StaticResource VSTextPrimary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 지역명 -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="지역명:" Foreground="{StaticResource VSTextSecondary}" VerticalAlignment="Center" Margin="0,0,15,0" Width="80"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Name="LocationNameInput" Background="{StaticResource VSDarkBg}" Foreground="{StaticResource VSTextPrimary}" BorderBrush="{StaticResource VSBorder}" Padding="8"/>

                                        <!-- 주소 -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="주소:" Foreground="{StaticResource VSTextSecondary}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Name="LocationAddressInput" Background="{StaticResource VSDarkBg}" Foreground="{StaticResource VSTextPrimary}" BorderBrush="{StaticResource VSBorder}" Padding="8"/>

                                        <!-- 담당자 -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="담당자:" Foreground="{StaticResource VSTextSecondary}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Name="LocationManagerInput" Background="{StaticResource VSDarkBg}" Foreground="{StaticResource VSTextPrimary}" BorderBrush="{StaticResource VSBorder}" Padding="8"/>

                                        <!-- 연락처 -->
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="연락처:" Foreground="{StaticResource VSTextSecondary}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                        <TextBox Grid.Row="6" Grid.Column="1" Name="LocationPhoneInput" Background="{StaticResource VSDarkBg}" Foreground="{StaticResource VSTextPrimary}" BorderBrush="{StaticResource VSBorder}" Padding="8"/>

                                        <!-- 비고 -->
                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="비고:" Foreground="{StaticResource VSTextSecondary}" VerticalAlignment="Top" Margin="0,8,15,0"/>
                                        <TextBox Grid.Row="8" Grid.Column="1" Name="LocationNotesInput" Background="{StaticResource VSDarkBg}" Foreground="{StaticResource VSTextPrimary}" BorderBrush="{StaticResource VSBorder}" Padding="8" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                                    </Grid>

                                    <Button Content="➕ 지역 추가" Click="AddLocation_Click" Style="{StaticResource VSAccentButton}" HorizontalAlignment="Right" Margin="0,15,0,0" Padding="15,8"/>
                                </StackPanel>
                            </Border>

                            <!-- 지역 목록 -->
                            <Border Background="{StaticResource VSLightBg}" BorderBrush="{StaticResource VSBorder}" BorderThickness="1" Padding="20">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15">
                                        <TextBlock Text="📍 등록된 지역 목록" Foreground="{StaticResource VSTextPrimary}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                        <Button Content="🔄 새로고침" Click="RefreshLocations_Click" Style="{StaticResource VSButton}" HorizontalAlignment="Right" Padding="10,5"/>
                                    </Grid>

                                    <!-- 지역 리스트 -->
                                    <Border Background="{StaticResource VSDarkBg}" BorderBrush="{StaticResource VSBorder}" BorderThickness="1" Padding="15" Height="300">
                                        <ListBox Name="LocationsListBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource VSTextPrimary}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource VSLightBg}" BorderBrush="{StaticResource VSBorder}" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="📍" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource VSTextPrimary}"/>
                                                                <TextBlock Text="{Binding Address}" FontSize="11" Foreground="{StaticResource VSTextSecondary}" Margin="0,3,0,0"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                    <TextBlock Text="담당자: " FontSize="10" Foreground="{StaticResource VSTextSecondary}"/>
                                                                    <TextBlock Text="{Binding Manager}" FontSize="10" Foreground="{StaticResource VSTextSecondary}"/>
                                                                    <TextBlock Text=" | 연락처: " FontSize="10" Foreground="{StaticResource VSTextSecondary}" Margin="10,0,0,0"/>
                                                                    <TextBlock Text="{Binding PhoneNumber}" FontSize="10" Foreground="{StaticResource VSTextSecondary}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                    
                                    <TextBlock Name="LocationStatusText" Text="상태: 준비" Foreground="{StaticResource VSTextSecondary}" FontSize="11" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</Window>
