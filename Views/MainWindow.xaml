<Window x:Class="OfficeManagerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OfficeManagerWPF.ViewModels"
        Title="Office Manager - 공유오피스 관리 시스템" 
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Visual Studio Dark Theme 색상 -->
        <SolidColorBrush x:Key="VSDarkBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="VSLightBg" Color="#2D2D30"/>
        <SolidColorBrush x:Key="VSAccent" Color="#007ACC"/>
        <SolidColorBrush x:Key="VSTextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="VSTextSecondary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="VSBorder" Color="#3F3F46"/>
        <SolidColorBrush x:Key="VSHover" Color="#3E3E40"/>

        <!-- 버튼 스타일 -->
        <Style x:Key="VSButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource VSLightBg}"/>
            <Setter Property="Foreground" Value="{StaticResource VSTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VSBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource VSHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 액센트 버튼 -->
        <Style x:Key="VSAccentButton" TargetType="Button" BasedOn="{StaticResource VSButton}">
            <Setter Property="Background" Value="{StaticResource VSAccent}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽 사이드바 (VS 스타일) -->
        <Border Grid.Column="0" Background="{StaticResource VSLightBg}" BorderBrush="{StaticResource VSBorder}" BorderThickness="0,0,1,0">
            <StackPanel>
                <!-- 로고 및 타이틀 -->
                <Border Background="{StaticResource VSAccent}" Padding="20,15">
                    <StackPanel>
                        <TextBlock Text="OFFICE MANAGER" 
                                   Foreground="White" 
                                   FontSize="14" 
                                   FontWeight="Bold"/>
                        <TextBlock Text="공유오피스 관리" 
                                   Foreground="#E0E0E0" 
                                   FontSize="11"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 메뉴 항목 -->
                <StackPanel Margin="0,10,0,0">
                    <!-- 대시보드 -->
                    <TextBlock Text="📋 메인 메뉴" 
                               Foreground="{StaticResource VSTextSecondary}" 
                               FontSize="11" 
                               Margin="20,0,0,10"/>

                    <Separator Background="{StaticResource VSBorder}" Margin="15,5"/>

                    <!-- 업체 관리 -->
                    <Button Style="{StaticResource VSButton}" 
                            Command="{Binding OpenCompanyManagementCommand}"
                            Padding="20,12"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏢" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="업체 관리" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <!-- 입금/지출 -->
                    <Button Style="{StaticResource VSButton}" 
                            Command="{Binding OpenPaymentExpenseCommand}"
                            Padding="20,12"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="입금/지출 관리" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <!-- 미수금 -->
                    <Button Style="{StaticResource VSButton}" 
                            Command="{Binding OpenUnpaidManagementCommand}"
                            Padding="20,12"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="미수금 관리" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <Separator Background="{StaticResource VSBorder}" Margin="15,5"/>

                    <!-- 알림 설정 -->
                    <Button Style="{StaticResource VSButton}" 
                            Command="{Binding OpenNotificationSettingsCommand}"
                            Padding="20,12"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔔" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="알림 설정" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <!-- 알림 내역 -->
                    <Button Style="{StaticResource VSButton}" 
                            Command="{Binding OpenNotificationLogsCommand}"
                            Padding="20,12"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="알림 내역" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 메인 컨텐츠 영역 -->
        <Grid Grid.Column="1" Background="{StaticResource VSDarkBg}">
            <!-- 지역 탭 (최상위) -->
            <TabControl Name="MainLocationTabs" 
                        Background="{StaticResource VSDarkBg}" 
                        BorderThickness="0" 
                        Padding="0">
                <TabControl.Resources>
                    <!-- 크롬 스타일 지역 탭 -->
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource VSTextSecondary}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="25,12"/>
                        <Setter Property="Margin" Value="0,0,0,0"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" 
                                            Background="{TemplateBinding Background}" 
                                            BorderThickness="0,0,0,3" 
                                            BorderBrush="Transparent"
                                            Margin="0,0,1,0"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter x:Name="ContentSite" 
                                                        VerticalAlignment="Center" 
                                                        HorizontalAlignment="Center"
                                                        ContentSource="Header"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="Transparent"/>
                                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource VSAccent}"/>
                                            <Setter Property="Foreground" Value="{StaticResource VSTextPrimary}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource VSHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- 전체 탭 -->
                <TabItem Header="전체" Tag="">
                    <!-- 기능 탭 (하위) -->
                    <TabControl Background="{StaticResource VSDarkBg}" BorderThickness="0" Padding="10">
                        <TabControl.Resources>
                            <!-- 기능 TabItem 스타일 -->
                            <Style TargetType="TabItem">
                                <Setter Property="Background" Value="{StaticResource VSLightBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource VSTextPrimary}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="20,10"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border Name="Border" Background="{TemplateBinding Background}" 
                                                    BorderThickness="0" Margin="2,0" CornerRadius="3,3,0,0">
                                                <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" 
                                                                HorizontalAlignment="Center"
                                                                ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource VSAccent}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource VSHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                <!-- 대시보드 탭 -->
                <TabItem Header="📊 대시보드">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="30">
                            <!-- 헤더 -->
                            <Grid Margin="0,0,0,25">
                                <StackPanel>
                                    <TextBlock Text="DASHBOARD" 
                                               Foreground="{StaticResource VSTextPrimary}" 
                                               FontSize="24" 
                                               FontWeight="Light"/>
                                    <TextBlock Text="{Binding SelectedPeriod, StringFormat={}{0}}" 
                                               Foreground="{StaticResource VSTextSecondary}" 
                                               FontSize="13"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>


                            <!-- 통계 카드 그리드 -->
                            <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 총 입금액 -->
                        <Border Grid.Column="0" Background="{StaticResource VSLightBg}" 
                                BorderBrush="{StaticResource VSBorder}" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <TextBlock Text="총 입금액" 
                                           Foreground="{StaticResource VSTextSecondary}" 
                                           FontSize="12"/>
                                <TextBlock Text="{Binding TotalPayments, StringFormat={}{0:N0}원}" 
                                           Foreground="#4EC9B0" 
                                           FontSize="28" 
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="↑ Income" 
                                           Foreground="#4EC9B0" 
                                           FontSize="11"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 총 지출액 -->
                        <Border Grid.Column="2" Background="{StaticResource VSLightBg}" 
                                BorderBrush="{StaticResource VSBorder}" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <TextBlock Text="총 지출액" 
                                           Foreground="{StaticResource VSTextSecondary}" 
                                           FontSize="12"/>
                                <TextBlock Text="{Binding TotalExpenses, StringFormat={}{0:N0}원}" 
                                           Foreground="#F48771" 
                                           FontSize="28" 
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="↓ Expense" 
                                           Foreground="#F48771" 
                                           FontSize="11"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 순이익 -->
                        <Border Grid.Column="4" Background="{StaticResource VSLightBg}" 
                                BorderBrush="{StaticResource VSBorder}" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <TextBlock Text="순이익" 
                                           Foreground="{StaticResource VSTextSecondary}" 
                                           FontSize="12"/>
                                <TextBlock Text="{Binding NetProfit, StringFormat={}{0:N0}원}" 
                                           Foreground="#569CD6" 
                                           FontSize="28" 
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="= Net Profit" 
                                           Foreground="#569CD6" 
                                           FontSize="11"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 빠른 정보 -->
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource VSLightBg}" 
                                BorderBrush="{StaticResource VSBorder}" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <TextBlock Text="ACTIVE COMPANIES" 
                                           Foreground="{StaticResource VSTextSecondary}" 
                                           FontSize="11"/>
                                <TextBlock Text="{Binding ActiveCompanies, StringFormat={}{0}}" 
                                           Foreground="{StaticResource VSTextPrimary}" 
                                           FontSize="36" 
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="개 업체" 
                                           Foreground="{StaticResource VSTextSecondary}" 
                                           FontSize="12"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource VSLightBg}" 
                                BorderBrush="#DC3545" BorderThickness="2" Padding="20">
                            <StackPanel>
                                <TextBlock Text="UNPAID ACCOUNTS" 
                                           Foreground="{StaticResource VSTextSecondary}" 
                                           FontSize="11"/>
                                <TextBlock Text="{Binding UnpaidCount, StringFormat={}{0}}" 
                                           Foreground="#DC3545" 
                                           FontSize="36" 
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="건 미수금" 
                                           Foreground="#DC3545" 
                                           FontSize="12"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                            <!-- 안내 텍스트 -->
                            <Border Background="{StaticResource VSLightBg}" 
                                    BorderBrush="{StaticResource VSAccent}" 
                                    BorderThickness="2,0,0,0" 
                                    Padding="15"
                                    Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="💡 시스템 안내" 
                                               Foreground="{StaticResource VSTextPrimary}" 
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="• 미수금 알림: 월초(1-5일), 중순(13-17일), 월말(25-30일) 자동 발송" 
                                               Foreground="{StaticResource VSTextSecondary}" 
                                               FontSize="12"
                                               Margin="0,8,0,3"/>
                                    <TextBlock Text="• 월세 납부 알림: 7일 전, 3일 전, 당일 자동 발송 (SMS + 이메일)" 
                                               Foreground="{StaticResource VSTextSecondary}" 
                                               FontSize="12"
                                               Margin="0,0,0,3"/>
                                    <TextBlock Text="• 알림 설정 메뉴에서 SMS/이메일 설정을 완료해주세요" 
                                               Foreground="#DCDCAA" 
                                               FontSize="12"
                                               Margin="0,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 데이터 관리 탭 -->
                <TabItem Header="📋 데이터 관리">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <!-- 헤더 -->
                            <Grid Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="데이터 관리" 
                                               Foreground="{StaticResource VSTextPrimary}" 
                                               FontSize="20" 
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="업체, 입금, 지출 데이터를 관리합니다" 
                                               Foreground="{StaticResource VSTextSecondary}" 
                                               FontSize="12"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 서브 탭 (4개 카테고리) -->
                            <TabControl Background="{StaticResource VSDarkBg}" BorderThickness="0">
                                <!-- 상주업체 탭 -->
                                <TabItem Header="상주업체">
                                    <StackPanel Margin="15">
                                        <TextBlock Text="상주업체 (현재 운영 중 - 상주)" 
                                                   Foreground="{StaticResource VSTextPrimary}" 
                                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        
                                        <!-- 버튼 영역 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button Content="🔄 새로고침" Click="RefreshResidentCompanies_Click" Style="{StaticResource VSButton}" Margin="0,0,5,0" Padding="12,6"/>
                                            <Button Content="📥 임대내역 가져오기" Click="ImportRentalRecords_Click" Style="{StaticResource VSAccentButton}" Margin="0,0,5,0" Padding="12,6"/>
                                            <Button Content="📤 엑셀 내보내기" Style="{StaticResource VSButton}" Margin="0,0,5,0" Padding="12,6"/>
                                        </StackPanel>

                                        <!-- 상주업체 데이터그리드 -->
                                                <DataGrid Name="ResidentCompaniesDataGrid" 
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  IsReadOnly="True"
                                                  SelectionMode="Single"
                                                  Background="{StaticResource VSDarkBg}"
                                                  Foreground="{StaticResource VSTextPrimary}"
                                                  RowBackground="{StaticResource VSLightBg}"
                                                  AlternatingRowBackground="#252526"
                                                  BorderBrush="{StaticResource VSBorder}"
                                                  BorderThickness="1"
                                                  GridLinesVisibility="Horizontal"
                                                  HorizontalGridLinesBrush="{StaticResource VSBorder}">

                                                    <!-- 비상주업체 탭 -->
                                <TabItem Header="비상주업체">
                                    <StackPanel Margin="15">
                                        <TextBlock Text="비상주업체 (현재 운영 중 - 비상주)" 
                                                   Foreground="{StaticResource VSTextPrimary}" 
                                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        
                                        <!-- 버튼 영역 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button Content="🔄 새로고침" Click="RefreshNonResidentCompanies_Click" Style="{StaticResource VSButton}" Margin="0,0,5,0" Padding="12,6"/>
                                            <Button Content="📥 임대내역 가져오기" Click="ImportRentalRecords_Click" Style="{StaticResource VSAccentButton}" Margin="0,0,5,0" Padding="12,6"/>
                                            <Button Content="📤 엑셀 내보내기" Style="{StaticResource VSButton}" Margin="0,0,5,0" Padding="12,6"/>
                                        </StackPanel>

                                        <!-- 비상주업체 데이터그리드 -->
                                        <DataGrid Name="NonResidentCompaniesDataGrid" 
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  IsReadOnly="True"
                                                  SelectionMode="Single"
                                                  Background="{StaticResource VSDarkBg}"
                                                  Foreground="{StaticResource VSTextPrimary}"
                                                  RowBackground="{StaticResource VSLightBg}"
                                                  AlternatingRowBackground="#252526"
                                                  BorderBrush="{StaticResource VSBorder}"
                                                  BorderThickness="1"
                                                  GridLinesVisibility="Horizontal"
                                                  HorizontalGridLinesBrush="{StaticResource VSBorder}"
                                                  Height="400">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="{StaticResource VSSelection}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource VSTextPrimary}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Padding" Value="10,8"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource VSBorder}"/>
                                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                                <DataGridTextColumn Header="업체명" Binding="{Binding Name}" Width="*"/>
                                                <DataGridTextColumn Header="구분" Binding="{Binding Status}" Width="100"/>
                                                <DataGridTextColumn Header="계약일" Binding="{Binding ContractDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                                                <DataGridTextColumn Header="월임대료" Binding="{Binding MonthlyFee, StringFormat=N0}" Width="100"/>
                                                <DataGridTextColumn Header="담당자" Binding="{Binding ContactPerson}" Width="100"/>
                                                <DataGridTextColumn Header="연락처" Binding="{Binding PhoneNumber}" Width="120"/>
                                                <DataGridTextColumn Header="지역" Binding="{Binding Location}" Width="80"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        
                                        <TextBlock Name="NonResidentStatusText" Text="상태: 준비" Foreground="{StaticResource VSTextSecondary}" FontSize="11" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </TabItem>

                                <!-- 폐업업체 탭 -->
                                <TabItem Header="폐업업체">
                                    <StackPanel Margin="15">
                                        <TextBlock Text="폐업업체 (계약 종료)" 
                                                   Foreground="{StaticResource VSTextPrimary}" 
                                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        
                                        <!-- 버튼 영역 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button Content="🔄 새로고침" Click="RefreshClosedCompanies_Click" Style="{StaticResource VSButton}" Margin="0,0,5,0" Padding="12,6"/>
                                            <Button Content="📥 임대내역 가져오기" Click="ImportRentalRecords_Click" Style="{StaticResource VSAccentButton}" Margin="0,0,5,0" Padding="12,6"/>
                                            <Button Content="📤 엑셀 내보내기" Style="{StaticResource VSButton}" Margin="0,0,5,0" Padding="12,6"/>
                                        </StackPanel>

                                        <!-- 폐업업체 데이터그리드 -->
                                        <DataGrid Name="ClosedCompaniesDataGrid" 
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  IsReadOnly="True"
                                                  SelectionMode="Single"
                                                  Background="{StaticResource VSDarkBg}"
                                                  Foreground="{StaticResource VSTextPrimary}"
                                                  RowBackground="{StaticResource VSLightBg}"
                                                  AlternatingRowBackground="#252526"
                                                  BorderBrush="{StaticResource VSBorder}"
                                                  BorderThickness="1"
                                                  GridLinesVisibility="Horizontal"
                                                  HorizontalGridLinesBrush="{StaticResource VSBorder}"
                                                  Height="400">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="{StaticResource VSSelection}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource VSTextPrimary}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Padding" Value="10,8"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource VSBorder}"/>
                                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                                <DataGridTextColumn Header="업체명" Binding="{Binding Name}" Width="*"/>
                                                <DataGridTextColumn Header="구분" Binding="{Binding Status}" Width="100"/>
                                                <DataGridTextColumn Header="계약일" Binding="{Binding ContractDate, StringFormat=yyyy-MM-dd}" Width="100"/>
