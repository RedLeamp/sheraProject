<Window x:Class="OfficeManagerWPF.Views.DataGridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="데이터 관리 - Office Manager" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>
        <!-- Visual Studio Dark Theme -->
        <SolidColorBrush x:Key="VSDarkBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="VSLightBg" Color="#2D2D30"/>
        <SolidColorBrush x:Key="VSAccent" Color="#007ACC"/>
        <SolidColorBrush x:Key="VSTextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="VSTextSecondary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="VSBorder" Color="#3F3F46"/>

        <!-- DataGrid 스타일 -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource VSLightBg}"/>
            <Setter Property="Foreground" Value="{StaticResource VSTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VSBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource VSBorder}"/>
            <Setter Property="RowBackground" Value="{StaticResource VSLightBg}"/>
            <Setter Property="AlternatingRowBackground" Value="#252526"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <!-- DataGrid Header 스타일 -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource VSAccent}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{StaticResource VSBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <!-- DataGrid Cell 스타일 -->
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource VSTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource VSAccent}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 버튼 스타일 -->
        <Style x:Key="VSButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource VSAccent}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource VSBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004578"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Border Grid.Row="0" Background="{StaticResource VSLightBg}" 
                BorderBrush="{StaticResource VSBorder}" 
                BorderThickness="0,0,0,1" 
                Padding="20,15">
            <StackPanel>
                <TextBlock Text="📊 데이터 관리" 
                          Foreground="{StaticResource VSTextPrimary}" 
                          FontSize="20" 
                          FontWeight="SemiBold"/>
                <TextBlock Text="업체, 입금, 지출 데이터를 Excel로 내보내거나 가져올 수 있습니다." 
                          Foreground="{StaticResource VSTextSecondary}" 
                          FontSize="12" 
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- 탭 컨트롤 -->
        <TabControl Grid.Row="1" 
                    Background="{StaticResource VSDarkBg}" 
                    BorderThickness="0" 
                    Margin="10">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" 
                                        Background="{StaticResource VSLightBg}" 
                                        BorderBrush="{StaticResource VSBorder}" 
                                        BorderThickness="1,1,1,0" 
                                        Margin="2,0,2,0" 
                                        Padding="15,10">
                                    <ContentPresenter ContentSource="Header" 
                                                    HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{StaticResource VSAccent}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#3E3E40"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="{StaticResource VSTextPrimary}"/>
                    <Setter Property="FontSize" Value="13"/>
                </Style>
            </TabControl.Resources>

            <!-- 업체 탭 -->
            <TabItem Header="🏢 업체 데이터">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 버튼 영역 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="🔄 새로고침" 
                                Style="{StaticResource VSButton}" 
                                Click="RefreshCompanies_Click" 
                                Margin="0,0,10,0"/>
                        <Button Content="📥 Excel 가져오기" 
                                Style="{StaticResource VSButton}" 
                                Click="ImportCompaniesExcel_Click" 
                                Margin="0,0,10,0"/>
                        <Button Content="📥 임대내역 가져오기" 
                                Style="{StaticResource VSButton}" 
                                Click="ImportComplexExcel_Click"
                                Background="#28A745"
                                Margin="0,0,10,0">
                            <Button.ToolTip>
                                <ToolTip>
                                    <TextBlock>
                                        <Run Text="남양/향남 임대내역 형식의 Excel 파일을 가져옵니다.&#10;"/>
                                        <Run Text="• 여러 시트 자동 처리&#10;"/>
                                        <Run Text="• 업체 정보 + 입금 내역 동시 추출"/>
                                    </TextBlock>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>
                        <Button Content="📤 Excel 내보내기" 
                                Style="{StaticResource VSButton}" 
                                Click="ExportCompaniesExcel_Click"/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" 
                              x:Name="CompaniesDataGrid" 
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="업체명" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="유형" Binding="{Binding Type}" Width="80"/>
                            <DataGridTextColumn Header="계약일" Binding="{Binding ContractDate, StringFormat=yyyy-MM-dd}" Width="120"/>
                            <DataGridTextColumn Header="월세" Binding="{Binding MonthlyFee, StringFormat=N0}" Width="100"/>
                            <DataGridTextColumn Header="담당자" Binding="{Binding ContactPerson}" Width="100"/>
                            <DataGridTextColumn Header="연락처" Binding="{Binding PhoneNumber}" Width="120"/>
                            <DataGridTextColumn Header="이메일" Binding="{Binding Email}" Width="180"/>
                            <DataGridCheckBoxColumn Header="활성" Binding="{Binding IsActive}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 입금 탭 -->
            <TabItem Header="💰 입금 데이터">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 버튼 영역 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="🔄 새로고침" 
                                Style="{StaticResource VSButton}" 
                                Click="RefreshPayments_Click" 
                                Margin="0,0,10,0"/>
                        <Button Content="📥 Excel 가져오기" 
                                Style="{StaticResource VSButton}" 
                                Click="ImportPaymentsExcel_Click" 
                                Margin="0,0,10,0"/>
                        <Button Content="📤 Excel 내보내기" 
                                Style="{StaticResource VSButton}" 
                                Click="ExportPaymentsExcel_Click"/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" 
                              x:Name="PaymentsDataGrid" 
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="업체명" Binding="{Binding CompanyName}" Width="150"/>
                            <DataGridTextColumn Header="입금일" Binding="{Binding PaymentDate, StringFormat=yyyy-MM-dd}" Width="120"/>
                            <DataGridTextColumn Header="금액" Binding="{Binding Amount, StringFormat=N0}" Width="120"/>
                            <DataGridTextColumn Header="기간" Binding="{Binding Period}" Width="100"/>
                            <DataGridTextColumn Header="결제방법" Binding="{Binding PaymentMethod}" Width="120"/>
                            <DataGridCheckBoxColumn Header="확인" Binding="{Binding IsConfirmed}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 지출 탭 -->
            <TabItem Header="📉 지출 데이터">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 버튼 영역 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="🔄 새로고침" 
                                Style="{StaticResource VSButton}" 
                                Click="RefreshExpenses_Click" 
                                Margin="0,0,10,0"/>
                        <Button Content="📥 Excel 가져오기" 
                                Style="{StaticResource VSButton}" 
                                Click="ImportExpensesExcel_Click" 
                                Margin="0,0,10,0"/>
                        <Button Content="📤 Excel 내보내기" 
                                Style="{StaticResource VSButton}" 
                                Click="ExportExpensesExcel_Click"/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" 
                              x:Name="ExpensesDataGrid" 
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="지출일" Binding="{Binding ExpenseDate, StringFormat=yyyy-MM-dd}" Width="120"/>
                            <DataGridTextColumn Header="카테고리" Binding="{Binding Category}" Width="120"/>
                            <DataGridTextColumn Header="금액" Binding="{Binding Amount, StringFormat=N0}" Width="120"/>
                            <DataGridTextColumn Header="설명" Binding="{Binding Description}" Width="250"/>
                            <DataGridTextColumn Header="기간" Binding="{Binding Period}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 하단 상태바 -->
        <Border Grid.Row="2" Background="{StaticResource VSLightBg}" 
                BorderBrush="{StaticResource VSBorder}" 
                BorderThickness="0,1,0,0" 
                Padding="15,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText" 
                          Text="준비됨" 
                          Foreground="{StaticResource VSTextSecondary}" 
                          FontSize="12"/>
                <TextBlock x:Name="TotalCountText" 
                          Text="" 
                          Foreground="{StaticResource VSAccent}" 
                          FontSize="12" 
                          Margin="20,0,0,0" 
                          FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
